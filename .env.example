# Copie para .env e ajuste. O arquivo .env NAO deve ir para o Git.

# Obrigatoria em producao. Gere com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=troque-esta-chave

# true apenas na sua maquina. NUNCA em producao.
DJANGO_DEBUG=true

# Dominios/IPs que podem servir o sistema, separados por virgula.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Necessario quando acessar por HTTPS/dominio (ex.: https://loja.exemplo.com.br)
DJANGO_CSRF_TRUSTED_ORIGINS=

DJANGO_TIME_ZONE=America/Sao_Paulo
DJANGO_LOG_LEVEL=INFO

# Opcional: PostgreSQL em producao. Sem isto, usa SQLite.
# DATABASE_URL=postgres://usuario:senha@localhost:5432/administra
